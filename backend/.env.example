# ─── Server ───────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────
# Local:
# MONGO_URI=mongodb://localhost:27017/ayusutra
# Atlas (production):
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ayusutra

# ─── JWT Auth ─────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_here
JWT_EXPIRES_IN=7d

# ─── Mappls API ───────────────────────────────────────
MAPPLS_CLIENT_ID=your_mappls_client_id_here
MAPPLS_CLIENT_SECRET=your_mappls_client_secret_here

# ─── Google Gemini API ────────────────────────────────
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Security & Encryption ────────────────────────────
DATA_ENCRYPTION_KEY=replace_with_a_secure_encryption_key

# ─── File Uploads ─────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
